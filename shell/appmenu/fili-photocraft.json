{
  "name": "PhotoCraft",
  "app": [
    {
      "label": "About PhotoCraft",
      "exec": "fili-photocraft ctl --pid %pid action about"
    }
  ],
  "menus": [
    {
      "label": "File",
      "children": [
        {
          "label": "Open…",
          "keys": "Ctrl+O",
          "exec": "fili-photocraft ctl --pid %pid action open"
        },
        {
          "sep": true
        },
        {
          "label": "Close",
          "keys": "Ctrl+W",
          "exec": "fili-photocraft ctl --pid %pid action close"
        }
      ]
    },
    {
      "label": "Edit",
      "children": [
        {
          "label": "Undo",
          "keys": "Ctrl+Z",
          "exec": "fili-photocraft ctl --pid %pid action undo"
        },
        {
          "label": "Redo",
          "keys": "Ctrl+Shift+Z",
          "exec": "fili-photocraft ctl --pid %pid action redo"
        }
      ]
    },
    {
      "label": "Select",
      "children": [
        {
          "label": "Select All",
          "keys": "Ctrl+A",
          "exec": "fili-photocraft ctl --pid %pid action select-all"
        },
        {
          "label": "Deselect",
          "keys": "Ctrl+D",
          "exec": "fili-photocraft ctl --pid %pid action deselect"
        },
        {
          "label": "Inverse",
          "keys": "Ctrl+Shift+I",
          "exec": "fili-photocraft ctl --pid %pid action select-inverse"
        },
        {
          "label": "Sky",
          "exec": "fili-photocraft ctl --pid %pid action select-sky"
        }
      ]
    },
    {
      "label": "Layer",
      "children": [
        {
          "label": "Show or Hide Layer",
          "exec": "fili-photocraft ctl --pid %pid action toggle-layer"
        },
        {
          "sep": true
        },
        {
          "label": "New Curves Adjustment",
          "exec": "fili-photocraft ctl --pid %pid action adjust-curves"
        },
        {
          "label": "Levels",
          "exec": "fili-photocraft ctl --pid %pid action adjust-levels"
        },
        {
          "label": "Hue/Saturation",
          "exec": "fili-photocraft ctl --pid %pid action adjust-hue-saturation"
        },
        {
          "label": "Brightness/Contrast",
          "exec": "fili-photocraft ctl --pid %pid action adjust-brightness-contrast"
        },
        {
          "label": "Vibrance",
          "exec": "fili-photocraft ctl --pid %pid action adjust-vibrance"
        },
        {
          "label": "Exposure",
          "exec": "fili-photocraft ctl --pid %pid action adjust-exposure"
        },
        {
          "label": "Color Balance",
          "exec": "fili-photocraft ctl --pid %pid action adjust-color-balance"
        },
        {
          "label": "Black & White",
          "exec": "fili-photocraft ctl --pid %pid action adjust-black-white"
        },
        {
          "label": "Threshold",
          "exec": "fili-photocraft ctl --pid %pid action adjust-threshold"
        },
        {
          "label": "Posterize",
          "exec": "fili-photocraft ctl --pid %pid action adjust-posterize"
        },
        {
          "label": "Photo Filter",
          "exec": "fili-photocraft ctl --pid %pid action adjust-photo-filter"
        },
        {
          "label": "New Invert Adjustment",
          "exec": "fili-photocraft ctl --pid %pid action adjust-invert"
        }
      ]
    },
    {
      "label": "View",
      "children": [
        {
          "label": "Zoom In",
          "keys": "Ctrl+=",
          "exec": "fili-photocraft ctl --pid %pid action zoom-in"
        },
        {
          "label": "Zoom Out",
          "keys": "Ctrl+-",
          "exec": "fili-photocraft ctl --pid %pid action zoom-out"
        },
        {
          "label": "Fit on Screen",
          "keys": "Ctrl+0",
          "exec": "fili-photocraft ctl --pid %pid action zoom-fit"
        },
        {
          "label": "Actual Size",
          "keys": "Ctrl+1",
          "exec": "fili-photocraft ctl --pid %pid action zoom-actual"
        },
        {
          "label": "Debug Logs",
          "keys": "Ctrl+Shift+L",
          "exec": "fili-photocraft ctl --pid %pid action debug"
        }
      ]
    },
    {
      "label": "Tools",

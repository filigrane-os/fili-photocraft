{
  "v": 1,
  "app_id": "fili-photocraft",
  "name": "PhotoCraft",
  "program": "fili-photocraft",
  "ctl": "fili-photocraft ctl --pid %pid",
  "commands": [
    {
      "verb": "action",
      "args": "NAME [ARG]",
      "summary": "Run a command of the window (the same names as its menu)",

# xbps package of fili-photocraft (PhotoCraft), read by distro/build-repo.sh. Qt Quick comes with Quickshell already; qt6-svg draws its
# icon, qt6-wayland is the platform plugin. The engine is linked in; wl-clipboard gives the clipboard, xdg-utils opens links.
DESC="PhotoCraft, the image editor of Filigrane (Qt Quick on the PhotoCraft engine, Rust)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-svg>=0 qt6-wayland>=0 wl-clipboard>=0 xdg-utils>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6"
PKG_LICENSE="GPL-3.0-or-later"
